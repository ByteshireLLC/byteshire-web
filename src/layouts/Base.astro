---
import { getCollection, type CollectionEntry } from "astro:content";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  // The app this page belongs to. Its brand, when it has one, dresses the whole
  // page, and its header and footer replace the studio's (SPEC › Principles).
  app?: CollectionEntry<"apps">;
  smartAppBanner?: { appId: string; argument?: string };
  ogImage?: string;
}

const SITE_TITLE = "Byteshire";
const SITE_DESCRIPTION = "Byteshire LLC makes apps for iPhone, iPad, Mac and Apple Watch, including Discboard and Lux Fidelium.";

const { title, description = SITE_DESCRIPTION, app, ogImage } = Astro.props;
const isHome = Astro.url.pathname === "/";
const fullTitle = title && !isHome ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();

// Every page of an app on the App Store offers Safari's Smart App Banner.
const smartAppBanner =
  Astro.props.smartAppBanner ?? (app?.data.appStore ? { appId: app.data.appStore.id } : undefined);

const brand = app?.data.brand;
const brandStyle = brand
  ? [
      `--brand-bg-top: ${brand.backgroundTop}`,
      `--brand-bg-bottom: ${brand.backgroundBottom}`,
      `--brand-accent: ${brand.accent}`,
      `--brand-button: ${brand.button}`,
      `--brand-highlight: ${brand.highlight}`,
      `--brand-text: ${brand.text}`,
      `--brand-muted: ${brand.mutedText}`,
      brand.font ? `--brand-font: "${brand.font.family}", ${brand.font.fallback}` : "",
    ]
      .filter(Boolean)
      .join("; ")
  : undefined;
const fontFace = brand?.font?.file
  ? `@font-face { font-family: "${brand.font.family}"; src: url("/fonts/${app!.id}/${brand.font.file}") format("truetype"); font-weight: 300 700; font-display: swap; }`
  : undefined;
const appPath = app ? `/${app.id}/` : undefined;
// Studio pages list every app that has a page of its own, as the home page does.
const appsWithLandingPages = app ? [] : (await getCollection("apps")).filter((entry) => entry.data.landingPage);
---
<!DOCTYPE html>
<html lang="en" class:list={{ branded: !!brand, "branded-light": brand?.scheme === "light" }} style={brandStyle}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:type" content="website">
  <meta property="og:title" content={title ?? SITE_TITLE}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  {smartAppBanner && (
    <meta name="apple-itunes-app" content={`app-id=${smartAppBanner.appId}${smartAppBanner.argument ? `, app-argument=${smartAppBanner.argument}` : ""}`}>
  )}
  {ogImage && <meta property="og:image" content={ogImage}>}
  {brand && <meta name="theme-color" content={brand.backgroundTop}>}
  {fontFace && <style is:inline set:html={fontFace}></style>}
  <link rel="sitemap" href="/sitemap-index.xml">
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap">
      {app && app.data.landingPage ? (
        <span class="brand">
          <a class="studio" href="/">Byteshire</a> <span class="crumb" aria-hidden="true">›</span> <a href={appPath}>{app.data.name}</a>
        </span>
        <nav class="site-nav" aria-label={app.data.name}>
          <a href={`${appPath}whats-new/`}>What’s New</a>
          <a href={`${appPath}support/`}>Support</a>
        </nav>
      ) : (
        <a class="brand" href="/">Byteshire</a>
        <nav class="site-nav">
          <a href="/discboard/">Discboard</a>
        </nav>
      )}
    </div>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer class="site-footer">
    <div class="wrap">
      {app && app.data.landingPage ? (
        <nav class="footer-links" aria-label={`${app.data.name} links`}>
          <a href={appPath}>{app.data.name}</a>
          <a href={`${appPath}whats-new/`}>What’s New</a>
          <a href={`${appPath}support/`}>Support</a>
          <a href={`/${app.id}-privacy/`}>Privacy</a>
          <a href={`/${app.id}-terms/`}>Terms</a>
        </nav>
        <p class="copyright">{app.data.name} is made by <a href="/">Byteshire</a>. © {year} Byteshire LLC</p>
      ) : (
        <nav class="footer-links">
          {appsWithLandingPages.map((entry) => <a href={`/${entry.id}/`}>{entry.data.name}</a>)}
          <a href="mailto:info@byteshire.com">Contact</a>
        </nav>
        <p class="copyright">© {year} Byteshire LLC</p>
      )}
    </div>
  </footer>
</body>
</html>
