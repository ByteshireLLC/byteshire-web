---
// Discboard's landing page. The copy is the App Store listing, imported from
// Discboard's MARKETING.md by scripts/import-app.py; the screenshots are its
// Koubou output. Change either in the Discboard repo, then import again.
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Blocks from "../../components/Blocks.astro";
import { appStoreURL } from "../../lib/appstore";
import { divideDescription, platformList } from "../../lib/listing";
import badge from "../../assets/badges/app-store-black-en-us.svg";
import icon from "../../assets/apps/discboard/icon.jpg";
import ogImage from "../../assets/apps/discboard/og.jpg";
import { getImage } from "astro:assets";

const app = (await getEntry("apps", "discboard"))!;
const listing = (await getEntry("listings", "discboard"))!.data;
const releases = (await getEntry("releases", "discboard"))!.data;
const latest = releases.versions[0];
const { story, features, rest } = divideDescription(listing.description);
const storeURL = appStoreURL(app, "byteshire-web");

const screens = import.meta.glob<{ default: ImageMetadata }>("../../assets/apps/discboard/screens/*/*.jpg", { eager: true });
const devices = ["iPhone", "iPad", "Mac"]
  .map((device) => ({
    device,
    shots: Object.entries(screens)
      .filter(([path]) => path.includes(`/screens/${device}/`))
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([, module]) => module.default),
  }))
  .filter((group) => group.shots.length > 0);

const og = await getImage({ src: ogImage, width: 1200, format: "jpg" });
---
<Base
  title="Discboard"
  description={app.data.summary}
  app={app}
  ogImage={new URL(og.src, Astro.site).toString()}
>
  <section class="app-hero wrap">
    <Image class="app-icon" src={icon} width={224} alt="" loading="eager" />
    <h1>Discboard</h1>
    <p class="tagline">{listing.subtitle}.</p>
    <p class="platforms">For {platformList(app.data.platforms)}. Plays through Apple Music.</p>
    <a class="store-badge" href={storeURL}>
      <img src={badge.src} width={badge.width} height={badge.height} alt="Download on the App Store">
    </a>
    <div>
      <a class="version-chip" href="/discboard/whats-new/"><strong>New in {latest.version}</strong> · See what’s new →</a>
    </div>
  </section>

  <section class="gallery" aria-label="Screenshots">
    <div class="device-tabs" role="radiogroup" aria-label="Device">
      {devices.map(({ device }, index) => (
        <>
          <input type="radio" name="device" id={`device-${device}`} checked={index === 0} />
          <label for={`device-${device}`}>{device}</label>
        </>
      ))}
    </div>
    {devices.map(({ device, shots }) => (
      <div class={`shots shots-${device}`}>
        <div class="shots-row">
          {shots.map((shot, index) => (
            <Image
              src={shot}
              widths={device === "iPhone" ? [300, 600] : [620, 1240]}
              sizes={device === "iPhone" ? "300px" : "(max-width: 700px) 86vw, 620px"}
              alt={`Discboard on ${device}, screenshot ${index + 1} of ${shots.length}`}
              loading={device === "iPhone" && index < 2 ? "eager" : "lazy"}
            />
          ))}
        </div>
      </div>
    ))}
  </section>

  <section class="app-story">
    <Blocks blocks={story} />
  </section>

  <h2 class="section-title">Everything it does</h2>
  <ul class="feature-grid">
    {features.map((feature) => (
      <li>
        <h3>{feature.title}</h3>
        {feature.body && <p>{feature.body}</p>}
      </li>
    ))}
  </ul>

  <section class="plans wrap">
    <h2 class="section-title">Free, with Premium when you want more</h2>
    <div class="plan-card">
      <Blocks blocks={rest} />
      <p class="fine-print"><a href="/discboard-terms/">Terms of Use</a> · <a href="/discboard-privacy/">Privacy Policy</a></p>
    </div>
  </section>
</Base>
