---
// Discboard's landing page: "the spread" (SPEC › Principles › "Every landing page
// is its own design"). The page behaves like the app. A stack of jewel cases fans
// out as the visitor scrolls, the phone rises into the gap, and a case flips open
// to its track list when tapped.
//
// Listing copy, features and plans come from Discboard's MARKETING.md, and the
// captures, covers and frames from scripts/import-app.py. The page's own lines,
// written for this design, live here. Cover art is the public-domain paintings
// Discboard's screenshots use, never real album art (App Store Review
// Guideline 4.5.2(ii); see the promo-board page).
import { getEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import Base from "../../layouts/Base.astro";
import Blocks from "../../components/Blocks.astro";
import Device from "../../components/Device.astro";
import { appStoreURL } from "../../lib/appstore";
import { divideDescription } from "../../lib/listing";
import badge from "../../assets/badges/app-store-black-en-us.svg";
import icon from "../../assets/apps/discboard/icon.jpg";
import ogImage from "../../assets/apps/discboard/og.jpg";
import gravity from "../../assets/apps/discboard/captures/iphone-gravity.jpg";
import neonBloom from "../../assets/apps/discboard/captures/iphone-neon-bloom.jpg";
import quietHours from "../../assets/apps/discboard/captures/iphone-quiet-hours.jpg";
import ipadGravity from "../../assets/apps/discboard/captures/ipad-gravity.jpg";

const app = (await getEntry("apps", "discboard"))!;
const listing = (await getEntry("listings", "discboard"))!.data;
const releases = (await getEntry("releases", "discboard"))!.data;
const latest = releases.versions[0];
const { features, rest } = divideDescription(listing.description);
const storeURL = appStoreURL(app, "byteshire-web");
const og = await getImage({ src: ogImage, width: 1200, format: "jpg" });

const coverFiles = import.meta.glob<{ default: ImageMetadata }>("../../assets/apps/discboard/props/covers/*.jpg", { eager: true });
const coverImages = Object.entries(coverFiles)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, module]) => module.default);

// Where each case lands, as a % of the viewport from its center: two loose
// columns either side of the phone, three distances out, with a little jitter.
let seed = 7;
const random = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const covers = coverImages.map((image, i) => {
  const side = i % 2 === 0 ? -1 : 1;
  const row = Math.floor(i / 2);
  return {
    image,
    x: (side * (21 + ((row * 2 + (side > 0 ? 1 : 0)) % 3) * 10 + random() * 4)).toFixed(1),
    y: (-34 + row * 8.5 + (random() - 0.5) * 5).toFixed(1),
    r0: ((random() - 0.5) * 12).toFixed(1),
    r: ((random() - 0.5) * 36).toFixed(1),
    s: (12 + random() * 8).toFixed(1),
    z: Math.round(random() * 10),
  };
});

// The fake album Discboard's own screenshots play (ScreenshotPlaybackFixtures.swift).
const sample = {
  title: "Singularity Point",
  artist: "Rowan Vance",
  tracks: [
    ["Event Horizon", "4:05"], ["Escape Velocity", "3:18"], ["Gravity Well", "6:52"], ["Singularity Point", "5:27"],
    ["Redshift", "4:46"], ["The Long Drift", "5:58"], ["Tidal Lock", "2:54"], ["Apoapsis", "4:23"],
    ["Signal Lost", "5:01"], ["Reentry", "3:49"],
  ],
};
---
<Base title="Discboard" description={app.data.summary} app={app} ogImage={new URL(og.src, Astro.site).toString()}>
  <section class="spread" data-spread>
    <div class="stage" style="--p: 0">
      <div class="headline">
        <h1>{listing.subtitle}.</h1>
        <p>Scroll, and spread them across the floor.</p>
      </div>
      {covers.map((c) => (
        <div class="case" style={`--x:${c.x};--y:${c.y};--r0:${c.r0};--r:${c.r};--s:${c.s};z-index:${c.z}`}>
          <Image src={c.image} widths={[160, 320, 480]} sizes="(max-width: 760px) 30vmin, 20vmin" alt="" loading="eager" />
        </div>
      ))}
      <div class="riser">
        <Device frame="iphone-17-pro-deep-blue-portrait" screens={[gravity]} sizes="(max-width: 760px) 26vh, 38vh" alt="Discboard on iPhone: a board of album covers arranged around a large one on a starfield" eager />
      </div>
    </div>
  </section>

  <section class="intro">
    <Image class="intro-icon" src={icon} width={160} alt="" />
    <p>Remember pulling sleeves out of their cases and spreading them across the floor? You’d put one on, sit with it, set it back down, reach for another. <strong>The floor was the playlist.</strong> Discboard is that feeling, on iPhone, iPad, Mac and Apple Watch — and in the car.</p>
    <a class="store-badge" href={storeURL}><img src={badge.src} width={badge.width} height={badge.height} alt="Download on the App Store"></a>
    <div><a class="version-chip" href="/discboard/whats-new/"><strong>New in {latest.version}</strong> · See what’s new →</a></div>
  </section>

  <section class="flip">
    <div class="flip-copy">
      <h2>Tap one. It turns around.</h2>
      <p>Every cover is a real CD jewel case: translucent shell, ribbed spine. Tap it and it lifts off the board and opens to every track. Tap a track and it plays through Apple Music.</p>
      <p class="hint">Go on — tap the case.</p>
    </div>
    <button class="jewel" type="button" aria-pressed="false" aria-label={`Flip the jewel case for ${sample.title} to see its track list`}>
      <span class="jewel-inner">
        <span class="jewel-front"><Image src={coverImages[0]} widths={[400, 760]} sizes="(max-width: 760px) 86vw, 380px" alt="" /></span>
        <span class="jewel-back">
          <strong>{sample.title}</strong>
          <em>{sample.artist}</em>
          <ol>{sample.tracks.map(([title, length]) => <li><span>{title}</span><span>{length}</span></li>)}</ol>
        </span>
      </span>
    </button>
  </section>

  <section class="duo">
    <div>
      <h2>A board for every mood.</h2>
      <p>Late nights, road trips, the records you’re rediscovering. Bring your own wallpaper, or use the bundled set.</p>
    </div>
    <div class="duo-devices">
      <Device frame="iphone-17-pro-deep-blue-portrait" screens={[neonBloom]} sizes="(max-width: 760px) 40vw, 240px" alt="A board of bright retro covers on a neon wallpaper" />
      <Device frame="iphone-17-pro-deep-blue-portrait" screens={[quietHours]} sizes="(max-width: 760px) 40vw, 240px" alt="A quiet late-night board of covers" />
    </div>
  </section>

  <section class="everywhere">
    <h2>Wherever you listen.</h2>
    <p>Boards sync through iCloud to your iPad and Mac. CarPlay lists them, folders and all. On Apple Watch, flip through a board with the Digital Crown.</p>
    <Device frame="ipad-pro-13-m4-space-gray-landscape" screens={[ipadGravity]} sizes="(max-width: 940px) 92vw, 860px" alt="Discboard on iPad: a wide board of covers on a starfield" />
  </section>

  <section class="tiles">
    <h2>Everything on the board.</h2>
    <ul>
      {features.map((f, i) => (
        <li style={`--tilt:${((i * 53) % 7) - 3}deg`}><h3>{f.title}</h3>{f.body && <p>{f.body}</p>}</li>
      ))}
    </ul>
  </section>

  <section class="plans">
    <h2>Free to start. Premium when you want more.</h2>
    <div class="plan-card">
      <Blocks blocks={rest} />
      <p class="fine-print"><a href="/discboard-terms/">Terms of Use</a> · <a href="/discboard-privacy/">Privacy Policy</a></p>
    </div>
    <a class="store-badge" href={storeURL}><img src={badge.src} width={badge.width} height={badge.height} alt="Download on the App Store"></a>
  </section>
</Base>

<script>
  // Drive the spread from scroll: --p runs 0 → 1 across the tall hero section.
  const spread = document.querySelector<HTMLElement>("[data-spread]");
  const stage = spread?.querySelector<HTMLElement>(".stage");
  if (spread && stage) {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      stage.style.setProperty("--p", "1");
      spread.classList.add("still");
    } else {
      let queued = false;
      const update = () => {
        queued = false;
        const rect = spread.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, -rect.top / (rect.height - window.innerHeight)));
        stage.style.setProperty("--p", p.toFixed(4));
      };
      const queue = () => {
        if (!queued) { queued = true; requestAnimationFrame(update); }
      };
      window.addEventListener("scroll", queue, { passive: true });
      window.addEventListener("resize", queue);
      update();
    }
  }
  document.querySelectorAll<HTMLButtonElement>(".jewel").forEach((button) => {
    button.addEventListener("click", () => {
      button.setAttribute("aria-pressed", String(button.getAttribute("aria-pressed") !== "true"));
    });
  });
</script>

<style>
  h1, h2, h3 { font-family: var(--brand-font); }
  .store-badge img { height: 54px; width: auto; }

  .spread { height: 260vh; position: relative; }
  .spread.still { height: auto; }
  .stage { position: sticky; top: 0; height: 100vh; overflow: hidden; }
  .spread.still .stage { position: relative; }
  .headline {
    position: absolute; top: 9vh; left: 0; right: 0; text-align: center; z-index: 20; padding: 0 20px;
    opacity: calc(1 - var(--p) * 1.6);
    transform: translateY(calc(var(--p) * -6vh));
  }
  .headline h1 { font-size: clamp(2.4rem, 7vw, 5rem); line-height: 1; margin: 0 0 12px; text-shadow: 0 2px 24px rgba(0, 0, 0, 0.6); }
  .headline p { color: var(--brand-muted); font-size: 1.1rem; margin: 0; }

  .case {
    position: absolute; left: 50%; top: 56%; width: calc(var(--s) * 1vmin); aspect-ratio: 1;
    transform: translate(-50%, -50%)
      translate(calc(var(--x) * var(--p) * 1vw), calc(var(--y) * var(--p) * 1vh))
      rotate(calc((var(--r0) + (var(--r) - var(--r0)) * var(--p)) * 1deg));
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.55);
    border-radius: 2px; overflow: hidden; will-change: transform;
  }
  .case img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* The jewel case: a ribbed spine on the left and a sheen across the plastic. */
  .case::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 9%; background: repeating-linear-gradient(90deg, rgba(0, 0, 0, 0.55) 0 1px, rgba(255, 255, 255, 0.12) 1px 3px); }
  .case::after { content: ""; position: absolute; inset: 0; background: linear-gradient(125deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0) 40%, rgba(255, 255, 255, 0.08) 70%, rgba(255, 255, 255, 0)); }

  .riser {
    --q: clamp(0, (var(--p) - 0.35) / 0.55, 1);
    position: absolute; left: 50%; bottom: 4vh; height: 78vh; aspect-ratio: 1350 / 2760; z-index: 30;
    transform: translateX(-50%) translateY(calc((1 - var(--q)) * 90vh));
  }
  .riser :global(.device) { height: 100%; }

  .intro { max-width: 760px; margin: 0 auto; padding: 96px 24px 48px; text-align: center; }
  .intro :global(.intro-icon) { width: 112px; height: 112px; border-radius: 25px; box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45); }
  .intro p { font-size: clamp(1.25rem, 2.6vw, 1.6rem); line-height: 1.5; color: var(--brand-muted); }
  .intro strong { color: var(--brand-text); font-family: var(--brand-font); font-weight: 600; }
  .intro .version-chip { margin-top: 18px; }

  .flip { max-width: 1000px; margin: 0 auto; padding: 96px 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: center; }
  .flip h2, .duo h2, .everywhere h2, .tiles h2, .plans h2 { font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.05; margin: 0 0 16px; }
  .flip p, .duo p, .everywhere p { font-size: 1.15rem; line-height: 1.6; color: var(--brand-muted); }
  .hint { font-family: var(--brand-font); color: var(--brand-highlight) !important; }
  .jewel { all: unset; cursor: pointer; perspective: 1400px; width: min(380px, 100%); aspect-ratio: 1; justify-self: center; }
  .jewel:focus-visible { outline: 3px solid var(--brand-accent); outline-offset: 8px; }
  .jewel-inner { display: block; position: relative; width: 100%; height: 100%; transform-style: preserve-3d; transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .jewel[aria-pressed="true"] .jewel-inner { transform: rotateY(180deg) translateZ(20px); }
  .jewel-front, .jewel-back { position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden; border-radius: 3px; overflow: hidden; box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6); }
  .jewel-front img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .jewel-front::after { content: ""; position: absolute; inset: 0; background: linear-gradient(125deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0) 45%); }
  .jewel-back { transform: rotateY(180deg); background: #ece9f5; color: #1b1830; padding: 22px 24px; box-sizing: border-box; display: flex; flex-direction: column; }
  .jewel-back strong { font-family: var(--brand-font); font-size: 1.3rem; }
  .jewel-back em { font-style: normal; color: #5a5577; margin-bottom: 10px; }
  .jewel-back ol { margin: 0; padding: 0; list-style: none; counter-reset: track; font-size: 0.92rem; }
  .jewel-back li { display: flex; justify-content: space-between; padding: 3px 0; border-bottom: 1px solid #d6d2e6; counter-increment: track; }
  .jewel-back li span:first-child::before { content: counter(track) ". "; color: #6b6688; }

  .duo { max-width: 1000px; margin: 0 auto; padding: 72px 24px; display: grid; grid-template-columns: 1fr 1.1fr; gap: 48px; align-items: center; }
  .duo-devices { display: flex; gap: 24px; justify-content: center; }
  .duo-devices :global(.device) { width: 46%; }
  .duo-devices :global(.device:nth-child(2)) { margin-top: 72px; }

  .everywhere { max-width: 900px; margin: 0 auto; padding: 96px 24px 48px; text-align: center; }
  .everywhere p { max-width: 34em; margin: 0 auto 40px; }

  .tiles { max-width: 1100px; margin: 0 auto; padding: 72px 24px; }
  .tiles h2 { text-align: center; margin-bottom: 40px; }
  .tiles ul { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 22px; }
  .tiles li { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 6px; padding: 20px; transform: rotate(var(--tilt)); transition: transform 0.3s ease; }
  .tiles li:hover { transform: rotate(0) scale(1.03); }
  .tiles h3 { font-size: 1.1rem; margin: 0 0 6px; }
  .tiles p { margin: 0; color: var(--brand-muted); font-size: 0.95rem; line-height: 1.5; }

  .plans { max-width: 760px; margin: 0 auto; padding: 72px 24px 120px; text-align: center; }
  .plans .plan-card { text-align: left; margin-bottom: 32px; }

  @media (max-width: 760px) {
    .case { top: 60%; width: calc(var(--s) * 1.5vmin); }
    .riser { height: 52vh; }
    .flip, .duo { grid-template-columns: 1fr; text-align: center; }
    .jewel { width: min(300px, 86%); }
    .jewel-back { padding: 14px 16px; }
    .jewel-back strong { font-size: 1.05rem; }
    .jewel-back em { margin-bottom: 4px; font-size: 0.85rem; }
    .jewel-back ol { font-size: 0.76rem; }
    .jewel-back li { padding: 1.5px 0; }
  }
  @media (prefers-reduced-motion: reduce) { .jewel-inner, .tiles li { transition: none; } }
</style>
