---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

// One card per app that has card copy and a page to land on.
const cards = (await getCollection("apps")).filter((app) => app.data.summary && app.data.landingPage);
---
<Base title="Byteshire">
  <section class="hero home-hero">
    <div class="wrap">
      <h1>Byteshire</h1>
      <p class="tagline">Carefully built apps for iPhone, iPad, and Mac.</p>
    </div>
  </section>

  <section class="home-products wrap">
    {cards.map((app) => (
      <a class="product-card" href={`/${app.id}/`}>
        <h2>{app.data.name}</h2>
        <p>{app.data.summary}</p>
        <span class="product-link">Learn more →</span>
      </a>
    ))}
  </section>

  <section class="home-contact wrap">
    <p>Questions? Email <a href="mailto:info@byteshire.com">info@byteshire.com</a>.</p>
  </section>
</Base>
