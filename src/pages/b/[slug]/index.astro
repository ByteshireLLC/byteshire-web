---
// Boards first lived at /b/<slug>/. Each old page now forwards to its board's
// page at /discboards/<slug>/. Discboard 1.3.1 still downloads the board file
// from /b/<slug>/board.discboardboard, which the passthrough integration copies.
import { getCollection } from "astro:content";
import Redirect from "../../../layouts/Redirect.astro";

export async function getStaticPaths() {
  const moved = await getCollection("movedBoards");
  return moved.map((page) => ({ params: { slug: page.id }, props: { page } }));
}

const { page } = Astro.props;
---
<Redirect to={page.data.redirect_to} title={page.data.title} />
