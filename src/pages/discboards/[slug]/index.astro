---
// The landing page for a promotional discboard at /discboards/<slug>/.
//
// Discboard claims /b/* as a universal link, so on a device with the app a tap
// opens the board directly and this page is never seen. It is the fallback for
// everyone else: people without the app, a link pasted into Safari, or an in-app
// browser that ignores universal links. The Open button and Smart App Banner use
// the /b/ form, because that is the one Discboard 1.3.1 understands.
//
// It shows the board's wallpaper, never its album covers. App Store Review
// Guideline 4.5.2(ii) bars using cover art in marketing without rights-holder
// permission; the covers appear only inside the app. See Discboard #108.
//
// Discboard's scripts/publish_board.py writes each board's front matter into
// discboards/<slug>/index.html; src/content.config.ts reads it from there.
import { getCollection, getEntry } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { appStoreURL } from "../../../lib/appstore";

export async function getStaticPaths() {
  const boards = await getCollection("boards");
  return boards.map((board) => ({ params: { slug: board.id }, props: { board } }));
}

const { board } = Astro.props;
const { promo_slug: slug, title, description, wallpaper_alt, wallpaper_credit } = board.data;
const app = (await getEntry("apps", "discboard"))!;
const storeURL = appStoreURL(app, `promo-${slug}`);
const pageURL = new URL(Astro.url.pathname, Astro.site);
---
<Base
  title={title}
  description={description}
  smartAppBanner={{ appId: app.data.appStore!.id, argument: new URL(`/b/${slug}`, Astro.site).toString() }}
  ogImage={new URL("wallpaper.jpg", pageURL).toString()}
>
  <article class="promo-board">
    <figure class="promo-wallpaper">
      <img src="wallpaper.jpg" alt={wallpaper_alt}>
    </figure>
    <div class="wrap promo-body">
      <p class="promo-kicker">A discboard</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="cta promo-actions">
        <a class="button" href={`discboard://b/${slug}`}>Open in Discboard</a>
        <a class="button button-secondary" href={storeURL}>Get Discboard on the App Store</a>
      </p>
      <p class="promo-hint">Already have Discboard? Tap “Open in Discboard” and the board opens in the app. New to Discboard? Get it from the App Store, then come back and tap this link again.</p>
      {wallpaper_credit && <p class="fine-print promo-credit">Wallpaper: {wallpaper_credit}</p>}
    </div>
  </article>
</Base>
